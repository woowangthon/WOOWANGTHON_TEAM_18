# 비워 두면 127.0.0.1(이 PC에서만). 컨테이너 이미지는 0.0.0.0으로 띄운다.
HOST=
# 비워 두면 8000
PORT=
# 필수. 플랫폼 서버 → AI 서버 요청의 Bearer 토큰(32자 이상, 예: `openssl rand -hex 32`). 플랫폼 서버 env에 같은 값을 넣는다. **비밀**이다: 커밋하지 않고 로그에 남기지 않는다. 비워 두면 부팅이 멈춘다.
AGENT_API_TOKEN=
# 비워 두면 2. 동시에 도는 에이전트 수. 넘으면 티켓 접수가 503 AGENT_BUSY다.
AGENT_MAX_RUNS=
# 필수. 플랫폼 서버 MCP 게이트웨이 주소(예: http://platform:4001/mcp). http · https만. 비워 두면 부팅이 멈춘다.
GATEWAY_URL=
# 로컬 모델(리더 vLLM)의 OpenAI 호환 API 주소와 모델 이름(예: http://vllm.internal:8000/v1, Qwen/Qwen3-8B-AWQ). LLM 분류 · playbook 실행에 쓴다. 둘 다 넣거나 둘 다 비운다. 비우면 서버는 뜨지만 문제 해결은 하지 않고 티켓마다 "AI 모델 설정이 없어 문제 해결을 하지 않았습니다"라는 gave_up을 낸다.
LOCAL_MODEL_URL=
LOCAL_MODEL_NAME=
# 로컬 모델의 API 키(vLLM --api-key). **비밀**이다. 키 없이 여는 서버면 비워 둔다.
LOCAL_MODEL_API_KEY=
# 추론 모델 API(OpenAI 호환)의 주소 · 모델 이름 · 키. planning에 쓴다. 주소와 이름은 둘 다 넣거나 둘 다 비운다. 비우면 planning도 로컬 모델이 한다. 키는 **비밀**이다.
PLANNER_MODEL_URL=
PLANNER_MODEL_NAME=
PLANNER_MODEL_API_KEY=
