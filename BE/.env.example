# 비워 두면 3000
PORT=
# 쉼표로 구분한 정확한 origin 목록(예: https://app.example.com). 비워 두면 다른 출처를 허용하지 않는다.
CORS_ORIGINS=
# 필수. Supabase 프로젝트 주소(대시보드 Project Settings → API의 Project URL, 끝에 / 없이). 비워 두면 부팅이 멈춘다.
SUPABASE_URL=
# 필수. Supabase의 공개 키(대시보드 Project Settings → API Keys의 publishable key. 예전 anon key도 된다). FE 번들에도 들어가는 공개 값이지만 .env.example에는 비워 둔다.
SUPABASE_PUBLISHABLE_KEY=
# 필수. Supabase의 secret key(대시보드 Project Settings → API Keys의 secret key. 예전 service_role key도 된다). 서버만 쓰는 **비밀**이다: FE에 넣지 않고, 커밋하지 않고, 로그에 남기지 않는다. 비워 두면 부팅이 멈춘다.
SUPABASE_SECRET_KEY=
# 필수. 비밀값의 해시(HMAC-SHA256)에 쓰는 서버 전용 키. **32자 이상**(예: `openssl rand -hex 32`로 만든다). 서버만 아는 **비밀**이다: 커밋하지 않고 로그에 남기지 않는다. 비워 두거나 짧으면 부팅이 멈춘다. 바꾸면 저장된 비밀값 해시가 새 키와 맞지 않아 `secretHash`가 달라진다.
SECRET_HASH_KEY=
# 선택. GoCD 서버 origin(예: https://gocd.example.com, 끝에 / 없이). 비워 두면 배포 시작이 503 PIPELINE_UNAVAILABLE이다.
GOCD_URL=
# 선택. GoCD access token. **비밀**: 커밋하지 않고 로그에 남기지 않는다.
GOCD_TOKEN=
# 선택. 배포 파이프라인 이름.
GOCD_PIPELINE=
# 선택. AI 에이전트의 시험 전용 파이프라인 이름(보통 student-trial). 비워 두면 게이트웨이의 run_* 도구가 PIPELINE_UNAVAILABLE로 실패한다.
GOCD_TRIAL_PIPELINE=
# 선택. 파이프라인이 알림을 보낼 때 쓰는 기계용 비밀 토큰(파이프라인의 GoCD secure 변수에 같은 값). **32자 이상**(예: `openssl rand -hex 32`). 이 토큰 하나로 배포 완료를 위조할 수 있다. 비워 두면 /api/pipeline/* 는 모두 401이다. **비밀**.
PIPELINE_NOTIFY_TOKEN=
# 선택. AI 서버 origin. 비워 두면 문제 티켓을 보내지 못해 AGENT_UNAVAILABLE로 마감한다.
AI_SERVER_URL=
# 선택. 플랫폼 → AI 서버 Bearer 토큰(AI 서버의 AGENT_API_TOKEN과 같은 값). **비밀**.
AGENT_API_TOKEN=
# 선택. AI 에이전트용 MCP 게이트웨이 내부 포트(예: 4001). 공개 PORT와 달라야 하고, 이 포트는 공개하지 않는다(AI 서버 컨테이너만 닿게). 비워 두면 게이트웨이를 열지 않는다. AI 서버의 GATEWAY_URL은 http://<이 서버>:<이 포트>/mcp.
GATEWAY_PORT=
# 리더 쿠버네티스 API 접속(학생 공간 만들기, 설계는 docs/design/space.md). 셋 다 비워 두면 서버는 뜨고 클러스터를 쓰는 기능만 503이다. 일부만 채우면 부팅이 멈춘다. 값은 인프라 담당이 따로 전달한다.
# 리더 API의 origin(Tailscale 주소), 예: https://100.x.y.z:6443 (끝에 / 없이)
K8S_API_URL=
# 서버 계정(platform-server)의 토큰. **비밀**: 커밋하지 않고 로그에 남기지 않는다.
K8S_TOKEN=
# 리더 API 인증서를 서명한 CA. **PEM만**(-----BEGIN CERTIFICATE----- ~ -----END CERTIFICATE----- 사이, `openssl x509 -text` 같은 앞 설명 글은 빼고) **base64 한 줄로** 적는다(배포처 env 파일은 변수당 한 줄만 받는다): base64 -w0 ca.crt (macOS는 base64 -i ca.crt)
K8S_CA_CERT=
# 선택. 보안 검사(UC-10)의 Trivy 취약점 DB 폴더(절대 경로). 비워 두면 검사하지 않고 진행 상태에 SCAN_UNAVAILABLE 경고를 보인다. 검사에는 PATH에 gitleaks · trivy가 있어야 한다(BE 이미지에 들어 있다). 운영은 Infra/aws/deploy-be.sh가 /var/cache/trivy를 넣는다.
TRIVY_CACHE_DIR=
# 선택. 워커 노드의 CPU · 메모리 사용률(%) 중 큰 값이 이 값 이상이면 클러스터에 자리가 없는 것으로 본다: 배포 시작은 409 CLUSTER_FULL이고, 대기 중인 배포는 자리가 날 때까지 출발하지 않는다. 1–100, 비우면 80. 운영 값은 SSM /wcp/be/CLUSTER_FULL_PERCENT.
CLUSTER_FULL_PERCENT=
# 선택. 운영자 Discord 채널의 웹후크 주소(운영 알림: 재시작 반복 자동 중지 · AI 판단 · 노드 경고). https://discord.com/api/webhooks/<id>/<token> 모양만 받는다. **비밀**: 주소만 알면 누구나 그 채널에 글을 쓸 수 있다. 비워 두면 운영자 Discord로 보내지 않는다(앱 안 표시는 그대로). 운영 값은 SSM /wcp/be/DISCORD_WEBHOOK_URL.
DISCORD_WEBHOOK_URL=
# 선택. GitHub API(api.github.com)에 Bearer로 붙이는 토큰. 공개 레포만 읽으므로 권한 없는 fine-grained PAT(Repository access: Public repositories, 권한 없음)면 된다. 비우면 인증 없이 서버 IP당 시간당 60번이라 여러 학생이 함께 쓰면 금방 503 GITHUB_RATE_LIMITED가 난다(있으면 시간당 5,000번). **비밀**: 커밋하지 않고 로그에 남기지 않는다. 운영 값은 SSM /wcp/be/GITHUB_TOKEN.
GITHUB_TOKEN=
