{
  "name": "pipeline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && tsc -p tsconfig.build.json",
