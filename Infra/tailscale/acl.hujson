// Tailnet access rules (build 09). Design: docs/design/cluster.md §8. In the admin console: the operator,
// platform-server and node rules since 2026-11-10, the teammates' share rule since 2026-11-11, the GoCD
// rule (build 09') since 2026-11-12, when the EC2 joined.
// Pasted by the tailnet owner into the admin console (Access controls). Replace every <..._IP> with the
// device's Tailscale address there only; the addresses are not kept in this repo.
// This replaces the whole policy of the tailnet. Anything not accepted below is denied, so the school
// PCs cannot open connections to the operator's devices, and reach the platform server only from the
// leader to the GoCD port. The tailnet is the
// operator's personal one: before saving, add every other device that must keep talking (phone, other
// PCs) to "hosts" and to the first rule, and carry over any "ssh" or "nodeAttrs" block the current
// policy has.
// The "tests" block is checked when the policy is saved: a policy that would cut the operator's SSH
// is refused instead of applied.
{
	"tagOwners": {
		// The EC2 joins with this tag: a one-time auth key that carries it, or a login approved by an admin.
		"tag:platform-server": ["autogroup:admin"],
	},
	"hosts": {
		"k3s-leader": "<LEADER_TAILSCALE_IP>",
		"k3s-w1": "<W1_TAILSCALE_IP>",
		"k3s-w2": "<W2_TAILSCALE_IP>",
		"operator-desktop": "<OPERATOR_DESKTOP_TAILSCALE_IP>",
		"operator-laptop": "<OPERATOR_LAPTOP_TAILSCALE_IP>",
	},
	"acls": [
		// The operator's own devices keep reaching each other.
		{
			"action": "accept",
			"src": ["operator-desktop", "operator-laptop"],
			"dst": ["operator-desktop:*", "operator-laptop:*"],
		},
		// Operator devices: SSH to the three nodes, and the leader API for check scripts
		// (Infra/platform/check.sh calls it with the server account's token).
		{
			"action": "accept",
			"src": ["operator-desktop", "operator-laptop"],
			"dst": ["k3s-leader:22,6443", "k3s-w1:22", "k3s-w2:22"],
		},
		// Platform server: the leader's Kubernetes API only.
		{
			"action": "accept",
			"src": ["tag:platform-server"],
			"dst": ["k3s-leader:6443"],
		},
		// Build 09': the leader's deploy executor (GoCD Agent) -> the GoCD server on the EC2 (26.1.0,
		// port 8153 for agent registration, work and the API alike). The port is not open to the internet.
		// In the admin console since 2026-11-12.
		{
			"action": "accept",
			"src": ["k3s-leader"],
			"dst": ["tag:platform-server:8153"],
		},
		// The AI server on the EC2 -> the local model, through `tailscale serve` on the leader (port 18000, forwarded
		// to the vLLM Service; Infra/vllm/base.yaml step 4). vLLM still asks for its API key. Added 2026-11-13.
		{
			"action": "accept",
			"src": ["tag:platform-server"],
			"dst": ["k3s-leader:18000"],
		},
		// Teammates the three nodes are shared with (Machines -> Share), all ports, for the operator's
		// absence in 2026-11 (cluster.md §8), in the admin console since 2026-11-11. Removed at the return
		// (cluster.md §13) together with the shares; restoring the disks does not remove either.
		// A shared user is named by the autogroup, not by e-mail, because this repo is public.
		{
			"action": "accept",
			"src": ["autogroup:shared"],
			"dst": ["k3s-leader:*", "k3s-w1:*", "k3s-w2:*"],
		},
	],
	"tests": [
		{
			"src": "operator-desktop",
			"accept": ["k3s-leader:22", "k3s-w1:22", "k3s-w2:22", "k3s-leader:6443"],
		},
		{
			"src": "operator-laptop",
			"accept": ["k3s-leader:22", "k3s-w1:22", "k3s-w2:22"],
		},
		{
			"src": "tag:platform-server",
			"accept": ["k3s-leader:6443", "k3s-leader:18000"],
			"deny": ["k3s-leader:22", "k3s-w1:22", "k3s-w2:6443", "operator-desktop:22"],
		},
		{
			"src": "k3s-w1",
			"deny": ["operator-desktop:22", "operator-laptop:22", "k3s-leader:22", "tag:platform-server:8153"],
		},
		{
			"src": "k3s-leader",
			"accept": ["tag:platform-server:8153"],
			"deny": ["tag:platform-server:22", "operator-desktop:22"],
		},
		// autogroup:shared cannot be a test source, so the teammates' rule has no test here.
	],
}
